# Configuración común de editores: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# En Markdown dos espacios al final de una línea son un salto de línea.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
